-- ============ РОЛИ ============
local ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 50, 50),
    Sheriff = Color3.fromRGB(70, 150, 255),
    Innocent = Color3.fromRGB(70, 255, 110),
}
local ROLE_RU = {Murderer = "Убийца", Sheriff = "Шериф", Innocent = "Мирный"}

local function IsAlive(plr)
    local c = plr and plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

local function HasTool(plr, name)
    local c = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    return (c and c:FindFirstChild(name)) or (bp and bp:FindFirstChild(name)) or nil
end

local function RoleByTools(plr)
    if HasTool(plr, "Knife") then return "Murderer" end
    if HasTool(plr, "Gun") then return "Sheriff" end
    return "Innocent"
end

local function GetRole(plr)
    local r = S.roles[plr.Name]
    if Config.PreciseRoles and r then return r end
    return RoleByTools(plr)
end

local function MyRole() return GetRole(player) end

local function RefreshRoles()
    local ok, data = pcall(function()
        return RepStorage.Remotes.Extras.GetPlayerData:InvokeServer()
    end)
    if ok and type(data) == "table" then
        local new = {}
        for name, info in pairs(data) do
            if type(info) == "table" and type(info.Role) == "string" then
                local role = info.Role
                if role == "Hero" then role = "Sheriff" end
                if ROLE_COLORS[role] then new[name] = role end
            end
        end
        S.roles = new
        S.remoteOK = true
    else
        S.remoteOK = false
    end
end
Task("roles", 3, function()
    if S.refreshing or not Config.PreciseRoles then return end
    S.refreshing = true
    task.spawn(function()
        RefreshRoles()
        S.refreshing = false
    end)
end)

