local collapsed = false
minBtn.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    local newH = collapsed and 48 or H
    local curH = main.Size.Y.Offset
    local pos = main.Position
    TS:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size = UDim2.new(0, W, 0, newH),
        Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + (newH - curH) / 2)}):Play()
    minBtn.Text = collapsed and "▲" or "▼"
end)

Unload = function()
    if not Running then return end
    Running = false
    Save()
    S.tasks = {}
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    ClearESP()
    if hum then pcall(function() hum.WalkSpeed = origSpeed end) end
    for _, g in ipairs(S.guis) do pcall(function() g:Destroy() end) end
    env.SakuraMobileUnload = nil
    print("🌸 SAKURA MOBILE выгружена")
end
closeBtn.MouseButton1Click:Connect(Unload)
env.SakuraMobileUnload = Unload

local function ToggleMenu()
    main.Visible = not main.Visible
    if main.Visible then
        mainScale.Scale = 0.88 * Config.MenuScale
        TS:Create(mainScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = Config.MenuScale}):Play()
    end
end

do
    local g = New("ScreenGui", {Name = "SakuraMobileBtn", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 998}, PlayerGui)
    S.guis[#S.guis + 1] = g
    local btn = New("TextButton", {Size = UDim2.new(0, 46, 0, 46), AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.new(0, 38, 0, 110), Text = "Sak", TextSize = 16, Font = Enum.Font.GothamBlack, AutoButtonColor = false,
        BorderSizePixel = 0}, g)
    Round(btn, 12)
    local st = New("UIStroke", {Thickness = 1.5}, btn)
    local sc = New("UIScale", {Scale = 1}, btn)
    UI.btnLogo = {frame = btn, text = btn, stroke = st}
    local dragging, moved, startInput, startPos = false, false, nil, nil
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, moved, startInput, startPos = true, false, i.Position, btn.Position
            TS:Create(sc, TweenInfo.new(0.1), {Scale = 0.9}):Play()
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    TS:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                    if not moved then ToggleMenu() end
                end
            end)
        end
    end)
    Conn(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - startInput
            if d.Magnitude > 6 then moved = true end
            if moved then
                local v = Camera.ViewportSize
                btn.Position = UDim2.new(0, math.clamp(startPos.X.Offset + d.X, 24, v.X - 24),
                    0, math.clamp(startPos.Y.Offset + d.Y, 24, v.Y - 24))
            end
        end
    end))
end

Conn(UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then ToggleMenu()
    elseif input.KeyCode == Enum.KeyCode.End then Unload() end
end))

