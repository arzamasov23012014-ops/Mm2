-- ============================================================
-- SILENT AIM (как в Pulse)
-- Ты стреляешь — скрипт подменяет камеру в этот момент.
-- Пуля летит в убийцу, если он внутри FOV круга.
-- ============================================================
local silentLock = false

local function FindMurdererTarget()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and IsAlive(plr) and GetRole(plr) == "Murderer" then
            local c = plr.Character
            if c then
                local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
                if head then return plr, head end
            end
        end
    end
    return nil, nil
end

local function InFOV(worldPos)
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local screen, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return false end
    local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
    return d <= Config.SilentAimFOV
end

local function ShootAtMurderer()
    if silentLock then return end
    if not char or not Camera then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "Gun" then return end

    local plr, part = FindMurdererTarget()
    if not plr or not part then return end
    if not InFOV(part.Position) then return end

    silentLock = true

    local realCF = Camera.CFrame
    local aimPos = part.Position
    if Config.SilentAimPredict then
        aimPos = aimPos + part.AssemblyLinearVelocity * 0.08
    end

    -- Подмена камеры → выстрел → возврат. БЕЗ wait между ними.
    Camera.CFrame = CFrame.new(realCF.Position, aimPos)
    pcall(function() tool:Activate() end)
    Camera.CFrame = realCF

    task.wait(0.05)
    silentLock = false
end

-- Ловим ТВОЙ выстрел (тап по экрану или ЛКМ)
Conn(UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not Config.SilentAim then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "Gun" then return end
    task.spawn(ShootAtMurderer)
end))

-- Авто-выстрел (опционально)
local lastAuto = 0
Task("silentaim_auto", 0.05, function()
    if not Config.SilentAimManual then return end
    if silentLock then return end
    if tick() - lastAuto < Config.SilentAimDelay then return end
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "Gun" then return end
    local plr, part = FindMurdererTarget()
    if not plr or not part then return end
    if not InFOV(part.Position) then return end
    lastAuto = tick()
    ShootAtMurderer()
end)

