local function FindGunDrop()
    if S.gunDrop and S.gunDrop.Parent then return S.gunDrop end
    if tick() - (S.lastSearch or 0) < 1 then return nil end
    S.lastSearch = tick()
    S.gunDrop = WS:FindFirstChild("GunDrop", true)
    return S.gunDrop
end

Conn(WS.DescendantAdded:Connect(function(o)
    if o.Name == "GunDrop" and o:IsA("BasePart") then
        S.gunDrop = o
        S.dropTime = tick()
        Toast("🔫 Пистолет упал!", 3)
    end
end))

local function HasGun()
    return ((char and char:FindFirstChild("Gun")) or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Gun"))) ~= nil
end

local grabbing, lastGrab = false, 0
local function GrabGun(drop, manual)
    if grabbing or not root or not drop or not drop.Parent then return end
    grabbing = true
    lastGrab = tick()
    task.spawn(function()
        local origCF = root.CFrame
        local picked = false
        if firetouchinterest then
            pcall(function()
                local touchPart = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg") or root
                firetouchinterest(touchPart, drop, 0)
                task.wait(0.05)
                firetouchinterest(touchPart, drop, 1)
            end)
            task.wait(0.2)
            picked = HasGun() or not drop.Parent
        end
        if not picked and (Config.GrabTeleport or manual) and drop.Parent and root then
            root.CFrame = drop.CFrame + Vector3.new(0, 2.5, 0)
            local t0 = tick()
            repeat
                task.wait(0.05)
                picked = HasGun() or not drop.Parent
            until picked or tick() - t0 > 1.5
            if Config.GrabReturn and root then root.CFrame = origCF end
        end
        if picked and (Config.GrabNotify or manual) then Toast("✅ Пистолет подобран") end
        grabbing = false
    end)
end

Task("grab", 0.2, function()
    if not Config.AutoGrab or grabbing or not root or not hum or hum.Health <= 0 then return end
    if tick() - lastGrab < 0.8 then return end
    local drop = FindGunDrop()
    if not drop or not drop.Parent or HasGun() then return end
    if Config.GrabSkipMurderer and MyRole() == "Murderer" then return end
    if Config.GrabRange > 0 and (drop.Position - root.Position).Magnitude > Config.GrabRange then return end
    GrabGun(drop, false)
end)

-- ============ ESP ============
local function RemoveESP(plr)
    local d = S.esp[plr]
    if d then
        pcall(function() d.hl:Destroy() end)
        pcall(function() d.gui:Destroy() end)
        S.esp[plr] = nil
    end
end

local function MakeESP(plr)
    local c = plr.Character
    local head = c and c:FindFirstChild("Head")
    if not head or not c:FindFirstChildOfClass("Humanoid") then return end
    local d = S.esp[plr]
    if d and d.char == c then return end
    RemoveESP(plr)
    local hl = New("Highlight", {Name = "SakHL", Adornee = c, FillTransparency = 0.7, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false}, c)
    local gui = New("BillboardGui", {Name = "SakGUI", Size = UDim2.new(0, 170, 0, 30), Adornee = head,
        AlwaysOnTop = true, StudsOffset = Vector3.new(0, 2.6, 0), Enabled = false}, c)
    local lbl = New("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12, Font = Enum.Font.GothamBold, TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = 0.3,
        Text = ""}, gui)
    S.esp[plr] = {hl = hl, gui = gui, lbl = lbl, char = c}
end

local function ClearESP()
    for plr in pairs(S.esp) do RemoveESP(plr) end
    if S.gunHL then pcall(function() S.gunHL:Destroy() end) S.gunHL = nil end
    if S.gunGui then pcall(function() S.gunGui:Destroy() end) S.gunGui = nil end
end

local function UpdateGunESP()
    local drop = Config.GunESP and FindGunDrop() or nil
    if drop and drop.Parent then
        if not S.gunHL or S.gunHL.Adornee ~= drop then
            if S.gunHL then pcall(function() S.gunHL:Destroy() end) end
            if S.gunGui then pcall(function() S.gunGui:Destroy() end) end
            S.gunHL = New("Highlight", {Name = "SakGunHL", Adornee = drop, FillColor = Color3.fromRGB(255, 215, 0),
                OutlineColor = Color3.fromRGB(255, 215, 0), FillTransparency = 0.4,
                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, drop)
            S.gunGui = New("BillboardGui", {Name = "SakGunGUI", Size = UDim2.new(0, 160, 0, 26), Adornee = drop,
                AlwaysOnTop = true, StudsOffset = Vector3.new(0, 2, 0)}, drop)
            S.gunLbl = New("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                TextColor3 = Color3.fromRGB(255, 215, 0), TextSize = 13, Font = Enum.Font.GothamBlack,
                TextStrokeTransparency = 0.3, Text = "🔫 ПИСТОЛЕТ"}, S.gunGui)
        end
        local dist = root and math.floor((drop.Position - root.Position).Magnitude) or 0
        S.gunLbl.Text = "🔫 ПИСТОЛЕТ " .. dist .. "m"
    elseif S.gunHL then
        pcall(function() S.gunHL:Destroy() end)
        pcall(function() S.gunGui:Destroy() end)
        S.gunHL, S.gunGui = nil, nil
    end
end

Task("esp", 0.1, function()
    UpdateGunESP()
    for plr in pairs(S.esp) do
        if not plr.Parent then RemoveESP(plr) end
    end
    if not Config.RoleESP then
        for _, d in pairs(S.esp) do d.hl.Enabled = false d.gui.Enabled = false end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then MakeESP(plr) end
    end
    for plr, d in pairs(S.esp) do
        local c = plr.Character
        local head = c and c:FindFirstChild("Head")
        if not head or d.char ~= c then
            RemoveESP(plr)
        else
            local role = GetRole(plr)
            local show = IsAlive(plr) and not (Config.HideInnocent and role == "Innocent")
            d.hl.Enabled = show
            d.gui.Enabled = show
            if show then
                local color = ROLE_COLORS[role] or Color3.new(1, 1, 1)
                d.hl.FillColor = color
                d.hl.OutlineColor = color
                local txt = ""
                if Config.ShowName then txt = plr.Name .. " " end
                txt = txt .. "[" .. (ROLE_RU[role] or role) .. "]"
                if Config.ShowDistance and root then
                    txt = txt .. " " .. math.floor((head.Position - root.Position).Magnitude) .. "m"
                end
                d.lbl.Text = txt
                d.lbl.TextColor3 = color
            end
        end
    end
end)
Conn(Players.PlayerRemoving:Connect(RemoveESP))

-- ============ ЛИНИИ ============
local function SetLine(fr, a, b)
    local v = b - a
    fr.Size = UDim2.new(0, v.Magnitude, 0, 2)
    fr.Position = UDim2.new(0, (a.X + b.X) / 2, 0, (a.Y + b.Y) / 2)
    fr.Rotation = math.deg(math.atan2(v.Y, v.X))
    fr.Visible = true
end
local lineFrames = {}
Task("lines", 0, function()
    if not Config.ESPLines then
        for _, f in ipairs(lineFrames) do f.Visible = false end
        return
    end
    if not S.linesGui or not S.linesGui.Parent then
        S.linesGui = New("ScreenGui", {Name = "SakuraMobileLines", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = -1}, player:WaitForChild("PlayerGui"))
        S.guis[#S.guis + 1] = S.linesGui
        lineFrames = {}
        for i = 1, 4 do
            lineFrames[i] = New("Frame", {AnchorPoint = Vector2.new(.5, .5), BorderSizePixel = 0,
                BackgroundTransparency = 0.2, Visible = false}, S.linesGui)
        end
    end
    local vp = Camera.ViewportSize
    local origin = Vector2.new(vp.X / 2, vp.Y)
    local n = 0
    local function add(pos, color)
        n = n + 1
        local fr = lineFrames[n]
        if not fr then return end
        local p = Camera:WorldToViewportPoint(pos)
        local pt = Vector2.new(p.X, p.Y)
        if p.Z < 0 then pt = Vector2.new(vp.X - p.X, vp.Y - p.Y) end
        fr.BackgroundColor3 = color
        SetLine(fr, origin, pt)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and IsAlive(plr) then
            local role = GetRole(plr)
            local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r and (role == "Murderer" or role == "Sheriff") then add(r.Position, ROLE_COLORS[role]) end
        end
    end
    local drop = FindGunDrop()
    if drop and drop.Parent then add(drop.Position, Color3.fromRGB(255, 215, 0)) end
    for i = n + 1, #lineFrames do lineFrames[i].Visible = false end
end)

