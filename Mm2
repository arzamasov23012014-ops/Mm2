}
local function T() return THEMES[Config.Mode] or THEMES.sakura end

local toastLbl, toastStroke, toastToken = nil, nil, 0
local function Toast(text, dur)
    if not Running then return end
    pcall(function()
        if not toastLbl or not toastLbl.Parent then
            local g = New("ScreenGui", {Name = "SakuraMobileToast", ResetOnSpawn = false, IgnoreGuiInset = true,
                DisplayOrder = 1000}, player:WaitForChild("PlayerGui"))
            S.guis[#S.guis + 1] = g
            toastLbl = New("TextLabel", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 8),
                Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.XY,
                BackgroundColor3 = Color3.fromRGB(14, 4, 26), BackgroundTransparency = 0.15,
                TextColor3 = Color3.new(1, 1, 1), TextSize = 13, Font = Enum.Font.GothamBold,
                BorderSizePixel = 0, Visible = false}, g)
            Round(toastLbl, 10)
            New("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14)}, toastLbl)
            toastStroke = New("UIStroke", {Thickness = 1.5, Transparency = 0.2}, toastLbl)
        end
        toastStroke.Color = T().accent
        toastToken = toastToken + 1
        local my = toastToken
        toastLbl.Text = text
        toastLbl.Position = UDim2.new(.5, 0, 0, -24)
        toastLbl.Visible = true
        TS:Create(toastLbl, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Position = UDim2.new(.5, 0, 0, 8)}):Play()
        task.delay(dur or 2, function()
            if my == toastToken and toastLbl then toastLbl.Visible = false end
        end)
    end)
end

local function Beep()
    pcall(function()
        local snd = New("Sound", {SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 1}, WS)
        snd:Play()
        Debris:AddItem(snd, 2)
    end)
end

local function Task(name, interval, fn)
    S.tasks[name] = {interval = interval, last = 0, fn = fn, fails = 0}
end
Conn(RS.Heartbeat:Connect(function(dt)
    local now = tick()
    for name, t in pairs(S.tasks) do
        if now - t.last >= t.interval then
            t.last = now
            local ok, err = pcall(t.fn, dt)
            if ok then
                t.fails = 0
            else
                t.fails = t.fails + 1
                warn("🌸 [" .. name .. "] " .. tostring(err))
                if t.fails >= 8 then
                    S.tasks[name] = nil
                    Toast("⚠️ Задача «" .. name .. "» остановлена из-за ошибок")
                end
            end
        end
    end
end))

