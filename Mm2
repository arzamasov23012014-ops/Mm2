Task("info", 0.5, function()
    if not UI.infoRoles or not UI.infoRoles.Parent or not UI.pages.info.Visible then return end
    local mur, she, alive, total = nil, nil, 0, 0
    for _, plr in ipairs(Players:GetPlayers()) do
        total = total + 1
        if IsAlive(plr) then alive = alive + 1 end
        local r = GetRole(plr)
        if r == "Murderer" then mur = plr elseif r == "Sheriff" then she = plr end
    end
    UI.murderer = mur
    local function fmt(plr)
        if not plr then return "не найден" end
        return plr.Name .. (IsAlive(plr) and "" or " (мёртв)")
    end
    UI.infoRoles.Text = "🔪 Убийца: " .. fmt(mur) .. "\n🔫 Шериф: " .. fmt(she) ..
        "\n👥 Живых: " .. alive .. " из " .. total
    local drop = FindGunDrop()
    if drop and drop.Parent then
        local d = root and math.floor((drop.Position - root.Position).Magnitude) or 0
        UI.infoGun.Text = "🔫 Пистолет лежит на карте\n📏 До него: " .. d .. " м"
    elseif HasGun() then
        UI.infoGun.Text = "🔫 Пистолет у тебя в инвентаре"
    else
        UI.infoGun.Text = "🔫 Пистолет не упал"
    end
    UI.infoMe.Text = "🧍 Твоя роль: " .. (ROLE_RU[MyRole()] or "—") ..
        "\n🛰 Роли через игру: " .. (S.remoteOK and "работает" or "недоступно (определяю по предметам)")
end)

