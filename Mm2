local function Themed(o, prop, key) S.themed[#S.themed + 1] = {o, prop, key} end
local function AddRef(owner, fn) S.refreshers[#S.refreshers + 1] = {owner = owner, fn = fn} end
local function Refresh()
    for i = #S.refreshers, 1, -1 do
        local r = S.refreshers[i]
        if r.owner:IsDescendantOf(game) then pcall(r.fn) else table.remove(S.refreshers, i) end
    end
end

local UI = {}
local function UpdateLogo()
    local th = T()
    for _, lg in ipairs({UI.logo, UI.btnLogo}) do
        if lg and lg.frame.Parent then
            lg.frame.BackgroundColor3 = th.logoBg
            lg.text.TextColor3 = th.logoText
            lg.stroke.Color = th.logoStroke
        end
    end
end
local function ApplyTheme()
    local th = T()
    for i = #S.themed, 1, -1 do
        local t = S.themed[i]
        if t[1]:IsDescendantOf(game) then t[1][t[2]] = th[t[3]] else table.remove(S.themed, i) end
    end
    if UI.main and UI.main.Parent then
        UI.main.BackgroundColor3 = th.bg
        UI.main.BackgroundTransparency = Config.MenuAlpha
    end
    UpdateLogo()
    Refresh()
end

local function Splash()
    pcall(function()
        local th = T()
