local function Slider(page, label, key, min, max, fmt, onChange)
    fmt = fmt or function(v) return tostring(math.floor(v + 0.5)) end
    local holder = New("Frame", {Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = CARD, BorderSizePixel = 0,
        LayoutOrder = Ord(page), ZIndex = 2}, page)
    Round(holder, 11)
    local lbl = New("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 12, 0, 6), BackgroundTransparency = 1,
        TextColor3 = Color3.new(1, 1, 1), TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3}, holder)
    local bar = New("Frame", {Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -28, 0, 8), BackgroundColor3 = Color3.fromRGB(60, 40, 82),
        BorderSizePixel = 0, Active = true, ZIndex = 3}, holder)
    Round(bar, 4)
    local fill = New("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, ZIndex = 3}, bar)
    Round(fill, 4)
    Themed(fill, "BackgroundColor3", "accent")
    local knob = New("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 4}, bar)
    Round(knob, 10)
    local function render()
        local v = Config[key]
        local a = math.clamp((v - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        lbl.Text = label .. ": " .. fmt(v)
    end
    AddRef(holder, render)
    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        Config[key] = min + (max - min) * a
        render()
        if onChange then pcall(onChange, Config[key]) end
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            S.activeSlider = setFromX
            S.activeScroll = bar:FindFirstAncestorOfClass("ScrollingFrame")
            if S.activeScroll then S.activeScroll.ScrollingEnabled = false end
            setFromX(i.Position.X)
        end
    end)
    render()
    return holder
end

