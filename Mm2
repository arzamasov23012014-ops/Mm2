local function Save()
    if not canFile then return end
    pcall(function() writefile(FILE, Http:JSONEncode(Config)) end)
end
local saveQueued = false
local function MarkDirty()
    if saveQueued or not Running then return end
    saveQueued = true
    task.delay(2, function()
        saveQueued = false
        if Running then Save() end
    end)
end
